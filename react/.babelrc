{
  "plugins": [
    "lodash",
    [
      "polyfill-corejs3",
      {
        // Babel 8 removed preset-env's useBuiltIns/corejs; polyfill
        // injection now lives in this dedicated plugin.
        "method": "usage-global",
        "version": "3.49",
        "proposals": true
      }
    ]
  ],
  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": false // Ensures ES modules are not transpiled to CommonJS
      }
    ],
    "@babel/preset-typescript"
  ],
  "overrides": [
    {
      // Only enable JSX parsing/transform for .jsx/.tsx files. Applying
      // preset-react globally (Babel 8) makes the parser treat generic
      // arrow functions in .ts files (`const f = <T>(x: T) => x`) as JSX.
      "test": ["**/*.jsx", "**/*.tsx"],
      "presets": ["@babel/preset-react"]
    }
  ],
  "env": {
    "production": {
      "plugins": [
        "lodash" // Retain Lodash plugin for additional optimization
      ]
    },
    "test": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "targets": {
              "node": "current"
            }
          }
        ]
      ],
      "plugins": ["istanbul"]
    }
  }
}
