{
  "plugins": [
    "lodash",
    [
      "polyfill-corejs3",
      {
        // Babel 8 removed preset-env's useBuiltIns/corejs; polyfill
        // injection now lives in this dedicated plugin.
        "method": "usage-global",
        "version": "3.49",
        "proposals": true
      }
    ]
  ],
  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": false // Ensures ES modules are not transpiled to CommonJS
      }
    ],
    [
      "@babel/preset-typescript",
      {
        // Babel 8 flipped this default to true, which keeps every
        // `import { SomeType }` (without the `import type` keyword) as a
        // real runtime import. Our code imports types with plain `import`
        // throughout, so the default pulled Storybook arg modules into the
        // app bundles and shifted module evaluation order — breaking apps
        // like create-patron at runtime. Restore Babel 7's usage-based
        // elision of type-only imports.
        "onlyRemoveTypeImports": false
      }
    ]
  ],
  "overrides": [
    {
      // Only enable JSX parsing/transform for .jsx/.tsx files. Applying
      // preset-react globally (Babel 8) makes the parser treat generic
      // arrow functions in .ts files (`const f = <T>(x: T) => x`) as JSX.
      // The "../" variants matter: workspace packages such as the service
      // layer resolve to paths outside this project root, and a leading "**"
      // does not match past "..". Without them their .tsx files reach the
      // parser with JSX disabled.
      "test": ["**/*.jsx", "**/*.tsx", "../**/*.jsx", "../**/*.tsx"],
      "presets": ["@babel/preset-react"]
    }
  ],
  "env": {
    "production": {
      "plugins": [
        "lodash" // Retain Lodash plugin for additional optimization
      ]
    },
    "test": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "targets": {
              "node": "current"
            }
          }
        ]
      ],
      "plugins": ["istanbul"]
    }
  }
}
