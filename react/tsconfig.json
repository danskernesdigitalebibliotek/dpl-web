{
  "extends": "@tsconfig/create-react-app/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "types": ["cypress", "node", "vitest/importMeta"],
    "target": "es6",
    "allowJs": true,
    "paths": {
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "cypress"
  ],
  "ts-node": {
    // these options are overrides used only by ts-node
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
