# =============================================================================
# 1Password-injectable environment template for the dpl-web monorepo.
#
# Generate the central root .env from this file with `task init:1pass`
# (env + symlinks + install deps) or `task dev:envfiles:1pass` (env only). Both
# run `op inject --in-file .env.1pass --out-file .env`, resolving the 1Password
# references below from the DDF vault. Every other value is a plain
# local-development value, kept in sync with .env.example.
#
# NOTE: op inject scans the whole file for "op:" + "//" tokens, including
# comments — so never write that literal prefix in prose here.
#
# Fill in the real third-party credentials (marked XXX) yourself, or get them
# from a colleague / 1Password.
# =============================================================================

# --- Docker Compose / tooling (CMS) ------------------------------------------
COMPOSE_PROJECT_NAME=dpl-cms
COMPOSER_MEMORY_LIMIT=-1
SKIP_ETC_HOSTS_MODIFICATION=1
DEV_TLD=local

# --- Service URLs ------------------------------------------------------------
# Base URL of the Go site: read by Go (its own URL) and by CMS (GoSite.php override).
DPL_GO_BASE_URL=https://dpl-cms.local:3000
DPL_CMS_BASE_URL=https://dpl-cms.local

# --- Adgangsplatformen -------------------------------------------------------
# Used by `task token:generate` to mint library tokens. These are the same
# Adgangsplatformen credentials as the OpenID/OIDC values below — resolved from
# 1Password (same vault fields).
ADGANGSPLATFORMEN_CLIENT_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_CLIENT_ID"
ADGANGSPLATFORMEN_CLIENT_SECRET="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_CLIENT_SECRET"
ADGANGSPLATFORMEN_AGENCY_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_AGENCY_ID"
# Adgangsplatformen OIDC (CMS dev/local login) — resolved from 1Password.
OPENID_CLIENT_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_CLIENT_ID"
OPENID_CLIENT_SECRET="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_CLIENT_SECRET"
OPENID_AGENCY_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/OPENID_AGENCY_ID"

# --- GraphQL consumers (internal — must be consistent across our services) ---
BNF_GRAPHQL_CONSUMER_SECRET=localdev-bnf-graphql-consumer-secret
BNF_GRAPHQL_CONSUMER_USER_PASSWORD=localdev-bnf-graphql-consumer-password
GO_GRAPHQL_CONSUMER_SECRET=localdev-go-graphql-consumer-secret
NEXT_PUBLIC_GO_GRAPHQL_CONSUMER_USER_NAME=go_graphql
NEXT_PUBLIC_GO_GRAPHQL_CONSUMER_USER_PASSWORD=localdev-go-graphql-consumer-password
MOBILE_GRAPHQL_CONSUMER_SECRET=localdev-mobile-graphql-consumer-secret
MOBILE_GRAPHQL_CONSUMER_USER_PASSWORD=localdev-mobile-graphql-consumer-password

# --- Shared internal secrets (CMS <-> Go) ------------------------------------
GO_SESSION_SECRET=localdev-go-session-secret-do-not-use-in-prod
DRUPAL_REVALIDATE_SECRET=localdev-revalidate-secret

# --- Unilogin (real third-party credentials) ---------------------------------
UNILOGIN_API_URL=https://broker.unilogin.dk
UNILOGIN_CLIENT_ID=https://ereolengo.dk/
UNILOGIN_CLIENT_SECRET="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_CLIENT_SECRET"
UNILOGIN_WELLKNOWN_URL=https://broker.unilogin.dk/auth/realms/broker/.well-known/openid-configuration
UNILOGIN_MUNICIPALITY_ID=101

# PubHub / Publizon. CMS reads UNILOGIN_PUBHUB_*; Go reads the misspelled
# UNLILOGIN_PUBHUB_* (a long-standing typo). Same values.
UNILOGIN_PUBHUB_CLIENT_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_CLIENT_ID"
UNILOGIN_PUBHUB_RETAILER_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_RETAILER_ID"
UNILOGIN_PUBHUB_RETAILER_KEY_CODE="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_RETAILER_KEY_CODE"
UNLILOGIN_PUBHUB_CLIENT_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_CLIENT_ID"
UNLILOGIN_PUBHUB_RETAILER_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_RETAILER_ID"
UNLILOGIN_PUBHUB_RETAILER_KEY_CODE="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_PUBHUB_RETAILER_KEY_CODE"

# Unilogin webservice (SOAP), Go only.
UNILOGIN_WS_UDBYDERSYSTEM_ID="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_WS_UDBYDERSYSTEM_ID"
UNILOGIN_WS_PRIVATE_KEY="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_WS_PRIVATE_KEY"
UNILOGIN_WS_PUBLIC_CERT="op://DDF/evemi3we5quxxtgkcrqvonvgsi/UNILOGIN_WS_PUBLIC_CERT"

# --- Dataforsyningen (Danish address lookup API) — resolved from 1Password ---
DATAFORSYNINGEN_TOKEN="op://DDF/evemi3we5quxxtgkcrqvonvgsi/DATAFORSYNINGEN_TOKEN"

# --- Videotool ---
VIDEOTOOL_PUBLIC_KEY="op://DDF/evemi3we5quxxtgkcrqvonvgsi/VIDEOTOOL_PUBLIC_KEY"
VIDEOTOOL_PRIVATE_KEY="op://DDF/evemi3we5quxxtgkcrqvonvgsi/VIDEOTOOL_PRIVATE_KEY"

# --- React / Storybook -------------------------------------------------------
# Only STORYBOOK_* and *_BASEURL vars reach the Storybook bundle.
STORYBOOK_LIBRARY_TOKEN=
STORYBOOK_USER_TOKEN=
STORYBOOK_DATAFORSYNINGEN="op://DDF/evemi3we5quxxtgkcrqvonvgsi/DATAFORSYNINGEN_TOKEN"
# Service base URLs for React/Storybook. Commented out on purpose: when unset,
# the apps fall back to the real DBC backends (see react/src/core/storybook/
# serviceUrlArgs.ts) — FBS → https://fbs-openplatform.dbc.dk, Publizon →
# https://pubhub-openplatform.dbc.dk, CMS → https://dpl-cms.local.
# Uncomment to point at local Wiremock mocks instead (run `task dev:mocks:start`
# first, and see docs/react/request_mocking_wiremock.md).
# FBS_BASEURL=http://fbs-mock.docker
# PUBLIZON_BASEURL=http://publizon-mock.docker
# CMS_BASEURL=http://cms-mock.docker

# --- schemas -----------------------------------------------------------------
# Library token for GraphQL schema introspection. Kept in sync with
# STORYBOOK_LIBRARY_TOKEN by `task token:generate`.
LIBRARY_TOKEN=
