type GoLibraryInfo {
  name: String
  cmsUrl: String!
}

type GoLoginUrls {
  adgangsplatformen: String
}

type GoLogoutUrls {
  adgangsplatformen: String
}

"""
Various FBI profiles configured by the local library.
"""
type SearchProfiles {
  """
  This is meant to be a fallback profile if no other profile is specified.
  But is not being used in the current implementation.
  """
  default: String
  """
  This is the profile used for searching works in the library's catalog.
  """
  local: String
  """
  This is the profile is using materials from other libraries as well.
  """
  global: String
}

type MappTracking {
  domain: String
  id: String
}

type UniloginConfigurationPrivate {
  clientSecret: String
  pubHubRetailerKeyCode: String
}

type UniloginConfigurationPublic {
  municipalityId: String
}

type GoConfigurationPrivate {
  unilogin: UniloginConfigurationPrivate
}

"""
Configuration the WeDoBooks SDK needs to run the reader and the player.
These are client keys, provisioned once per environment - never per library.
"""
type GoBiblioSdkConfiguration {
  applicationId: String!
  firebaseApiKey: String!
  firebaseProjectId: String!
  firebaseAppId: String!
  readerApiKey: String!
}

"""
Biblio adapter configuration for GO.
"""
type GoBiblioConfiguration {
  """
  Whether digital materials on GO go through the Biblio adapter.
  Independent of the flag governing the CMS web apps.
  """
  enabled: Boolean!
  """
  Base url of the Biblio adapter.
  """
  baseUrl: String
  """
  Null unless every SDK value is provisioned - the SDK cannot start on a
  partial configuration.
  """
  sdk: GoBiblioSdkConfiguration
}

type GoConfigurationPublic {
  biblio: GoBiblioConfiguration
  libraryInfo: GoLibraryInfo
  loginUrls: GoLoginUrls
  logoutUrls: GoLogoutUrls
  mapp: MappTracking
  searchProfiles: SearchProfiles
  unilogin: UniloginConfigurationPublic
  """
  Branch ids whose materials should be excluded when computing availability.
  """
  blacklistedAvailabilityBranches: [String!]
}

type GoConfiguration {
  public: GoConfigurationPublic
  private: GoConfigurationPrivate
}
