{% extends '@dpl_service_message/dpl-service-message-bar.html.twig' %}

{% block content %}
  {% set tag = message.url ? 'a' : 'div' %}

  <section class="service-message-bar"
    aria-label="{{ 'Important service message'|t({}, {context: 'dpl_service_message'}) }}">
    <{{ tag }}
      {% if message.url %}href="{{ message.url }}"{% endif %}
      class="service-message-bar__inner{{ message.url ? ' arrow arrow__hover--right-small' : '' }}">

      <span class="service-message-bar__icon" aria-hidden="true">
        {{ source(themeIconPath ~ '/icon-bell.svg') }}
      </span>

      <div class="service-message-bar__content">
        {# Not a heading element, and deliberately unlike the in-page container,
           which uses h2. The bar draws its heading at body size in the body
           face - visually it reads as emphasised text, not as a heading - so
           `strong` is what it is (KB-64). #}
        {% if message.heading %}
          <strong class="service-message-bar__heading">{{ message.heading }}</strong>
        {% endif %}
        {% if message.body %}
          <div class="service-message-bar__body">{{ message.body }}</div>
        {% endif %}
      </div>

      {% if message.url %}
        <span class="service-message-bar__arrow" aria-hidden="true">
          {{ source(baseIconPath ~ '/arrow-ui/icon-arrow-ui-small-right.svg') }}
        </span>
      {% endif %}
    </{{ tag }}>
  </section>
{% endblock %}
