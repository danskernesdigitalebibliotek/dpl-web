     return this.$view.hasClass('view-eva') || !this.$view.parents('.view').length;
   };
 
+  /**
+   * Show the pager loading indicator inline instead of full screen.
+   *
+   * Views defaults pager AJAX to a full-screen progress indicator, which
+   * Drupal positions fixed in the middle of the viewport. For infinite scroll
+   * that means a spinner floats on screen even when the visitor has not
+   * scrolled down to where the next results load. Switching to the inline
+   * "throbber" indicator renders it next to the pager - at the bottom of the
+   * list - so it only appears once the visitor reaches it.
+   */
+  var originalAttachPagerLinkAjax = Drupal.views.ajaxView.prototype.attachPagerLinkAjax;
+  Drupal.views.ajaxView.prototype.attachPagerLinkAjax = function (id, link) {
+    originalAttachPagerLinkAjax.call(this, id, link);
+    if (this.pagerAjax && this.pagerAjax.progress) {
+      this.pagerAjax.progress.type = 'throbber';
+    }
+  };
+
 })(jQuery, Drupal, Drupal.debounce);
