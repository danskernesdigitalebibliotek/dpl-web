diff --git a/tests/src/Kernel/EventCreationServiceTest.php b/tests/src/Kernel/EventCreationServiceTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..ceb999b58fb6be89b2a89aaf78de2aaae76a4f3f
--- /dev/null
+++ b/tests/src/Kernel/EventCreationServiceTest.php
@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\recurring_events\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\Tests\recurring_events\Traits\EventSeriesCreationTrait;
+
+/**
+ * @coversDefaultClass \Drupal\recurring_events\EventCreationService
+ * @group recurring_events
+ * @requires module field_inheritance
+ */
+class EventCreationServiceTest extends KernelTestBase {
+
+  use EventSeriesCreationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'datetime',
+    'datetime_range',
+    'field_inheritance',
+    'options',
+    'recurring_events',
+    'system',
+    'text',
+    'user',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('eventseries');
+    $this->installEntitySchema('eventinstance');
+    $this->installConfig([
+      'field_inheritance',
+      'recurring_events',
+      'datetime',
+      'system',
+    ]);
+  }
+
+  /**
+   * Occurrences sharing a start date but not an end date are both kept.
+   *
+   * @covers ::calculateEventSeriesDates
+   * @covers ::calculateDatesFromConfigArray
+   * @covers ::createInstances
+   */
+  public function testSameStartDateWithDifferentEndDates(): void {
+    $series = $this->createUnsavedEventSeries([
+      'recur_type' => 'custom',
+      'custom_date' => [
+        ['value' => '2030-01-07T10:00:00', 'end_value' => '2030-01-07T12:00:00'],
+        ['value' => '2030-01-07T10:00:00', 'end_value' => '2030-01-07T14:00:00'],
+      ],
+    ]);
+
+    $dates = $this->container->get('recurring_events.event_creation_service')
+      ->calculateEventSeriesDates($series);
+    $this->assertCount(2, $dates, 'Occurrences with the same start date but different end dates should each be calculated.');
+
+    $series->save();
+    $instances = $series->getInstances();
+    $this->assertCount(2, $instances, 'Occurrences with the same start date but different end dates should each be created.');
+
+    $actual = [];
+    foreach ($instances as $instance) {
+      $actual[] = [
+        'start' => $instance->date->start_date->format('Y-m-d\TH:i:s'),
+        'end' => $instance->date->end_date->format('Y-m-d\TH:i:s'),
+      ];
+    }
+    usort($actual, fn (array $a, array $b) => $a['end'] <=> $b['end']);
+
+    $this->assertSame([
+      ['start' => '2030-01-07T10:00:00', 'end' => '2030-01-07T12:00:00'],
+      ['start' => '2030-01-07T10:00:00', 'end' => '2030-01-07T14:00:00'],
+    ], $actual, 'Both occurrences should keep the dates they were configured with.');
+  }
+
+  /**
+   * Occurrences sharing both a start and an end date collapse into one.
+   *
+   * @covers ::calculateEventSeriesDates
+   * @covers ::calculateDatesFromConfigArray
+   * @covers ::createInstances
+   */
+  public function testIdenticalDatesCreateOneInstance(): void {
+    $series = $this->createUnsavedEventSeries([
+      'recur_type' => 'custom',
+      'custom_date' => [
+        ['value' => '2030-01-07T10:00:00', 'end_value' => '2030-01-07T12:00:00'],
+        ['value' => '2030-01-07T10:00:00', 'end_value' => '2030-01-07T12:00:00'],
+      ],
+    ]);
+
+    $dates = $this->container->get('recurring_events.event_creation_service')
+      ->calculateEventSeriesDates($series);
+    $this->assertCount(1, $dates, 'Occurrences with identical start and end dates should be calculated only once.');
+
+    $series->save();
+    $this->assertCount(1, $series->getInstances(), 'Occurrences with identical start and end dates should be created only once.');
+  }
+
+}
