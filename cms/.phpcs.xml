<?xml version="1.0"?>
<ruleset>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,css,info,txt,md,yml"/>
  <file>web/modules/custom</file>
  <file>web/profiles/dpl_cms</file>
  <file>web/themes/custom</file>
  <!-- Exclude built assets used by Novel -->
  <exclude-pattern>web/themes/custom/novel/assets/*</exclude-pattern>
  <file>assets/all.settings.php</file>
  <!-- Exclude generated client -->
  <exclude-pattern>web/modules/custom/*/src/GraphQL/*</exclude-pattern>

  <rule ref="Drupal" />
  <rule ref="DrupalPractice"/>
  <rule ref="Drupal.Commenting">
    <!--
      We want to be able to use strict typing even in hooks.
      But that conflicts with the Drupal Hook Comment rules.
      By disabling the rules we are able to document params and return.
    -->
    <exclude name="Drupal.Commenting.HookComment.HookParamDoc"/>
    <exclude name="Drupal.Commenting.HookComment.HookReturnDoc"/>
    <exclude name="Drupal.Commenting.HookComment.HookCommentFormat"/>
    <exclude name="Drupal.Commenting.FileComment.Missing"/>
    <!--
      Disable variable checking rules which both overlap and conflict with
      PHPStan as suggested by Drupal Coder developers:
      https://www.drupal.org/project/coder/issues/3253472#comment-14508517
    -->
    <exclude name="Drupal.Commenting.VariableComment.IncorrectVarType"/>
    <exclude name="Drupal.Commenting.VariableComment.IncorrectVarType"/>
    <!--
      Disable deprecation related sniffs that are seem to Drupal Core development.
    -->
    <!--
      Do not require specifying when deprecated function will be removed.
      We do not enforce this whin the project.
    -->
    <exclude name="Drupal.Commenting.Deprecated.IncorrectTextLayout"/>
    <!--
      Do not require a @see tag with link to Drupal.org for deprecation.
    -->
    <exclude name="Drupal.Commenting.Deprecated.DeprecatedMissingSeeTag"/>
  </rule>

  <!-- Custom rules to ensure new hook implementations are OO-based -->
  <rule ref="./phpcs/Dpl" />

  <!-- Ignore existing procedual hooks until they're magrated. -->
  <rule ref="Dpl.Hooks.NoProceduralHooks">
    <exclude-pattern>*/web/modules/custom/dpl_admin/dpl_admin.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_article/dpl_article.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_breadcrumb/dpl_breadcrumb.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_cookies/dpl_cookies.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_dashboard/dpl_dashboard.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_event/dpl_event.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_example_content/dpl_example_content.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_favorites_list/dpl_favorites_list.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_fbi/dpl_fbi.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_fees/dpl_fees.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_footer/dpl_footer.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_library_agency/dpl_library_agency.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_library_token/dpl_library_token.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_link/dpl_link.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_loans/dpl_loans.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_login/dpl_login.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_mail/dpl_mail.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_mapp/dpl_mapp.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_media/dpl_media.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_opening_hours/dpl_opening_hours.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_page/dpl_page.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_paragraphs/dpl_paragraphs.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_patron_menu/dpl_patron_menu.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_patron_page/dpl_patron_page.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_patron_reg/dpl_patron_reg.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_po/dpl_po.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_protected_nodes/dpl_protected_nodes.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_publication/dpl_publication.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_react/dpl_react.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_react_apps/dpl_react_apps.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_related_content/dpl_related_content.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_reservations/dpl_reservations.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_search/dpl_search.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/dpl_webform/dpl_webform.module</exclude-pattern>
    <exclude-pattern>*/web/modules/custom/media_twentythree/media_twentythree.module</exclude-pattern>
  </rule>

</ruleset>
