.gitmessage

# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/themes/custom/novel/assets/

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore the generated translation files. Only the combined file is committed;
# these two are derived from it and are published to GitHub Pages by CI.
# See docs/cms/translation.md.
/web/profiles/dpl_cms/translations/da.po
/web/profiles/dpl_cms/translations/da.config.po

# Ingore files that are only for the current local environment
web/sites/*/settings.local.php
web/sites/*/services.local.yml

# Ignore SimpleTest multi-site environment.
web/sites/simpletest

# Ignore test databases
web/test.sqlite*

# Ignore logs generated by test tools
/.lighthouseci/
/cypress/videos/
/cypress/screenshots/

# Task workspace and environment file
.task.env

# drush contrib commands
drush/Commands/contrib

# The lagoon.site.yml is generated by amazeeio/drupal_integrations
# We don't need that.
drush/sites/lagoon.site.yml

# Cache folder
.cache
.build
.drush-lock-update
.twig-cs-fixer.cache

# Ignore docker compose override file. Not everybody needs it.
docker-compose.override.yml

# Module upload folder
/web/modules/local

# We use this in the BNF setup, it should never be committed.
/web/sites/sites.php
