# The cli/php/nginx images build with the repository root as their Docker build
# context (see cms/docker-compose.yml), so this file — not cms/.dockerignore —
# governs what those builds receive and copy.

# Repo metadata / tooling not needed in any image.
/.git
/*.lagoon.*
/.github
/docs
/migration

# CMS build artifacts — must stay out of the images. Previously excluded by
# cms/.dockerignore, which no longer applies now the context is the repo root.
/cms/vendor
/cms/web/sites/default/files

# Host dependency installs. In CI/dev these add ~1GB to every context
# transfer; the js-assets stage runs its own pnpm install.
**/node_modules

# Task fingerprint state and env files. Both appear or change between
# builds in the same job, which invalidates the COPY cms layer and forces
# a full image rebuild during `docker compose up`. Ignoring .env also
# keeps secrets out of the build context.
**/.task
**/.env

# Host-built frontend assets (from local builds or the CI artifact).
# Images bake these via the js-assets stage instead; leaving them in the
# context makes layers differ between otherwise identical builds.
/design-system/build
/react/dist
/cms/web/themes/custom/novel/assets/dpl-design-system
/cms/web/libraries/dpl-react
