# The cli/php/nginx images (and go/lagoon/base.dockerfile) build with the
# repository root as their Docker build context (see cms/docker-compose.yml), so
# this file governs what those builds receive and copy.

# node_moules inside workspace packages only contain symlinks under pnpm, no
# point including them in the Docker context, since we do pnpm install anyway.
**/node_modules

# Repo metadata / tooling not needed in any image.
/.git
/*.lagoon.*
/.github
/docs
/migration

# CMS build artifacts — must stay out of the images. Previously excluded by
# cms/.dockerignore, which no longer applies now the context is the repo root.
/cms/vendor
/cms/web/sites/default/files
