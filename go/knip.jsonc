{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-knip-ignore"
  ],
  // Report exports only when they are used outside their own file. Without
  // this, Knip flags in-file-only exports (mostly conventional `*Props`
  // types), which is a separate cleanup.
  "ignoreExportsUsedInFile": true,
  "entry": [
    ".storybook/mocks/**",
    ".storybook/test-runners/**",
    ".storybook/google-fonts-mock.js"
  ],
  // Generated code; not meant to be analysed for dead exports.
  "ignore": [
    "lib/soap/**/generated/**",
    "lib/rest/**/generated/**",
    "lib/helpers/zod-validation.ts"
  ],
  // CLI invoked ad-hoc, not referenced from source.
  "ignoreBinaries": [
    "shadcn"
  ],
  // Babel/loader deps referenced from Webpack/Storybook config, and
  // http-server invoked via full path in CI — Knip cannot detect either.
  "ignoreDependencies": [
    "@babel/core",
    "@babel/preset-env",
    "@babel/preset-react",
    "@babel/preset-typescript",
    "@jest/types",
    "babel-loader",
    "http-server",
    "@types/jwt-simple"
  ]
}
