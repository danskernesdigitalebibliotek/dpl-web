{
  "name": "@danskernesdigitalebibliotek/dpl-dependabot-ignore-lint",
  "version": "0.1.0",
  "private": true,
  "description": "Fails CI when an ignore rule in .github/dependabot.yml is already satisfied by the installed version",
  "type": "module",
  "bin": {
    "dependabot-ignore-lint": "./src/cli.ts"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24",
    "@types/semver": "^7.7.1",
    "eslint": "^10.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
