{
  "name": "@danskernesdigitalebibliotek/dpl-service-layer",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./biblio/contract": "./biblio/src/generated/model/index.ts",
    "./fbi/contract": "./fbi/src/generated/graphql.ts"
  },
  "scripts": {
    "codegen:fbs": "orval --config fbs/orval.config.ts",
    "codegen:biblio": "orval --config biblio/orval.config.ts",
    "codegen:fbi": "graphql-codegen --config fbi/codegen.yml",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/react-query": "^5.104.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "eslint": "^10.4.0",
    "globals": "^17.13.0",
    "graphql": "^17.0.2",
    "knip": "^6.41.0",
    "orval": "^8.44.0",
    "prettier": "^3.9.10",
    "react": "^19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
