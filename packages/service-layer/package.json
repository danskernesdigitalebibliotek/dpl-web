{
  "name": "@danskernesdigitalebibliotek/dpl-service-layer",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./biblio/contract": "./biblio/src/generated/model/index.ts"
  },
  "scripts": {
    "codegen:fbs": "orval --config fbs/orval.config.ts",
    "codegen:biblio": "orval --config biblio/orval.config.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.101.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "eslint": "^10.4.0",
    "globals": "^17.11.0",
    "orval": "^7.21.0",
    "prettier": "^3.9.6",
    "react": "^19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
